{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "/",
      "framework": "nextjs",
      "buildCommand": "pnpm --filter @the-static/web run build",
      "outputDirectory": "apps/web/.next",
      "installCommand": "pnpm install"
    },
    "admin": {
      "root": "/",
      "framework": "nextjs",
      "buildCommand": "pnpm --filter @the-static/admin run build",
      "outputDirectory": "apps/admin/.next",
      "installCommand": "pnpm install"
    }
  },
  "rewrites": [
    { "source": "/admin(/.*)?", "destination": { "service": "admin" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
