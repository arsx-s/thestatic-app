{
  "version": 3,
  "routes": [
    { "src": "/_next/static/(.*)", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "src": "/auth/callback", "dest": "/auth/callback" },
    { "src": "/(.*)", "dest": "/" }
  ],
  "builds": [
    { "src": "apps/admin/package.json", "use": "@vercel/next", "config": { "target": "serverless" } }
  ]
}
