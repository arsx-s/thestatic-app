{
  "expo": {
    "name": "The Static",
    "slug": "the-static",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#070707"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thestatic.app",
      "infoPlist": {
        "NSCameraUsageDescription": "The Static needs access to your camera to capture photos and videos for posts, stories and messages.",
        "NSPhotoLibraryUsageDescription": "The Static needs access to your photo library to select media for posts, stories and messages.",
        "NSMicrophoneUsageDescription": "The Static needs access to your microphone to record voice messages.",
        "NSFaceIDUsageDescription": "The Static uses Face ID to secure app unlock and sensitive actions."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#070707",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.thestatic.app",
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-crypto",
      "expo-secure-store",
      "expo-media-library",
      "expo-image-picker",
      "expo-av",
      [
      "expo-notifications",
      {
        "strategy": "set-as-placholder-icon",
        "androidMode": "default",
        "androidChannel": "The Static",
        "androidColor": "#070707"
      }
    ],
      "expo-sharing",
      "expo-haptics",
      "expo-linking",
      "expo-web-browser",
      "react-native-reanimated/plugin",
      "react-native-gesture-handler",
      "react-native-svg"
    ]
  }
}
